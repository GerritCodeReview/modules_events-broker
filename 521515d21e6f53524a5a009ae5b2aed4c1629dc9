      },
      "writtenOn": "2026-06-08T17:05:05Z",
      "side": 1,
      "message": "We are not creating a corresponding `receiveAsyncWithPartition` for this method. I suspect we are not using this implementation. Should we remove or at least deprecate this interface in a separate change?",
      "range": {
        "startLine": 45,
        "startChar": 7,
        "endLine": 45,
        "endChar": 19
      },
      "revId": "521515d21e6f53524a5a009ae5b2aed4c1629dc9",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "ac5a701e_170c2638",
